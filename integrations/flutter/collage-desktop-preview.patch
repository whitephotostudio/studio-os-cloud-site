+    await io(tester);
+    await click(tester, find.byKey(const ValueKey('collage-open-commerce')));
+    await waitFor(tester, find.byKey(const ValueKey('collage-commerce-price')));
+    await tester.enterText(
+        find.byKey(const ValueKey('collage-commerce-price')), '25.001');
+    await click(
+        tester,
+        find.byKey(const ValueKey(
+            'collage-commerce-gallery-school:$commerceGallery')));
+    await click(tester, find.byKey(const ValueKey('collage-commerce-publish')));
+    await waitFor(tester,
