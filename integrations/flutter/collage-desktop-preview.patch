+        if (path == null) return;
+        final bytes = await renderCollagePng(_template, _placements, _captions,
+            overlay: _overlay);
+        _assertSession();
+        await _writeExport(File(path), bytes);
+        if (mounted) {
+          setState(() => _status =
+              'Exported ${_template.pixelWidth} × ${_template.pixelHeight} PNG. Set lab dimensions explicitly.');
+        }
+      });
