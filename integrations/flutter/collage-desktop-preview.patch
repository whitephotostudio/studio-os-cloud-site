+  Future<void> _exportTemplate() => _run(() async {
+        final path = await FilePicker.platform.saveFile(
+            dialogTitle: 'Export reusable template',
+            fileName: '${_safeName()}.json',
+            type: FileType.custom,
+            allowedExtensions: ['json']);
+        if (path == null) return;
+        _assertSession();
+        await _writeExport(File(path), utf8.encode(_template.exportJson()));
