+        _assertSession();
+        if (!mounted) {
+          image.dispose();
+          return;
+        }
+        _images.add(image);
+        final placement = CollagePlacement(image, p.basename(path));
+        setState(() {
+          _photos.add(placement);
+          _placements[slotId] = placement;
+        });
+      });
+
+  Future<void> _exportPng() => _run(() async {
+        final path = await FilePicker.platform.saveFile(
+            dialogTitle: 'Export print-sized preview PNG',
+            fileName:
+                '${_safeName()}_${_template.pixelWidth}x${_template.pixelHeight}.png',
+            type: FileType.custom,
