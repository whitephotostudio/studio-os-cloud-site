+                          child: Text(_error!,
+                              key: const ValueKey('collage-commerce-error'),
+                              style: TextStyle(color: Colors.red.shade800))),
+                    if (_status != null)
+                      Padding(
+                          padding: const EdgeInsets.symmetric(vertical: 10),
+                          child: Text(_status!,
+                              key: const ValueKey('collage-commerce-status'))),
+                    if (_pending != null)
+                      Card(
+                          child: Padding(
+                              padding: const EdgeInsets.all(12),
+                              child: Column(
+                                  crossAxisAlignment: CrossAxisAlignment.start,
