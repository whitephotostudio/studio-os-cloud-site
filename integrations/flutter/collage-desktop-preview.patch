+++ b/lib/screens/collages_screen.dart
@@ -0,0 +1,858 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+import 'package:path/path.dart' as p;
+
+import '../models/collage_template.dart';
+import '../services/collage_renderer.dart';
+import '../services/collage_cloud_service.dart';
+import '../storage/account_scope.dart';
+import '../storage/collage_store.dart';
+
+/// Native design preview. Purchases and production remain gated until Cloud
+/// gallery/cart/server rendering integration is verified end to end.
+class CollagesScreen extends StatefulWidget {
+  const CollagesScreen({super.key});
+
+  @override
+  State<CollagesScreen> createState() => _CollagesScreenState();
+}
+
+class _CollagesScreenState extends State<CollagesScreen> {
+  CollageTemplate _template = CollageTemplate.preset();
+  CollageStore? _store;
+  SavedCollageVersion? _saved;
+  List<SavedCollageVersion> _library = [];
+  List<CloudCollageVersion> _cloudLibrary = [];
+  String? _cloudTemplateId;
+  late final String? _ownerId;
+  late final int _session;
+  final Map<String, CollagePlacement> _placements = {};
+  final List<ui.Image> _images = [];
+  final List<CollagePlacement> _photos = [];
+  final List<String> _captions = ['Student name', 'School name', '2026'];
+  ui.Image? _overlay;
+  String? _error;
+  String? _status;
+  bool _busy = false;
+  bool _dirty = false;
+  bool _invalidDesign = false;
+  bool _guides = true;
+  int _formEpoch = 0;
+
+  @override
+  void initState() {
+    super.initState();
+    _ownerId = AccountScope.currentAccountId;
+    _session = AccountScope.sessionRevision.value;
+    AccountScope.sessionRevision.addListener(_accountChanged);
+    _openLibrary();
+  }
+
+  void _accountChanged() {
+    if (!mounted) return;
+    setState(() {
+      _placements.clear();
+      _photos.clear();
+      _library = [];
+      _cloudLibrary = [];
+      _cloudTemplateId = null;
+      _store = null;
+      _saved = null;
+      _overlay = null;
+      _captions.setAll(0, ['', '', '']);
+      _template = CollageTemplate.preset();
+      _formEpoch++;
+      _error = 'The studio account changed. Reopen Collages.';
+    });
+  }
+
+  @override
+  void dispose() {
+    AccountScope.sessionRevision.removeListener(_accountChanged);
+    for (final image in _images) {
+      image.dispose();
+    }
+    super.dispose();
+  }
+
+  Future<void> _openLibrary() async {
+    try {
+      final store = await CollageStore.open();
+      final library = await store.versions();
+      if (mounted) {
+        setState(() {
+          _store = store;
+          _library = library;
+        });
+      }
+    } catch (error) {
+      if (mounted) setState(() => _error = _message(error));
+    }
+  }
+
+  String _message(Object error) =>
+      error is FormatException ? error.message : '$error';
+
+  void _assertSession() {
+    if (AccountScope.currentAccountId != _ownerId ||
+        AccountScope.sessionRevision.value != _session) {
+      throw StateError('The studio account changed. Reopen Collages.');
+    }
+    _store?.assertActive();
+  }
+
+  Future<void> _run(Future<void> Function() action) async {
+    if (_busy) return;
+    setState(() {
+      _busy = true;
+      _error = null;
+      _status = null;
+    });
+    try {
+      _assertSession();
+      await action();
+    } catch (error) {
+      if (mounted) setState(() => _error = _message(error));
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  void _apply(Map<String, dynamic> changes) {
+    try {
+      final next = _template.changed(changes);
+      setState(() {
+        _template = next;
+        _invalidDesign = false;
+        _dirty = true;
+        _error = null;
+        _status = null;
+      });
+    } catch (error) {
+      setState(() {
+        _error = _message(error);
+        _invalidDesign = true;
+      });
+    }
+  }
+
+  void _slot(CollageSlot slot, Map<String, dynamic> changes) => _apply({
+        'slots': _template.slots
+            .map((entry) => entry.id == slot.id
+                ? {...entry.value, ...changes}
+                : entry.value)
+            .toList(),
+      });
+
+  Future<bool> _discard() async {
+    if (!_dirty) return true;
+    return await showDialog<bool>(
+            context: context,
+            builder: (context) => AlertDialog(
+                  title: const Text('Unsaved collage changes'),
+                  content: const Text(
+                      'Save a version before switching designs, or discard these changes.'),
+                  actions: [
+                    TextButton(
+                        onPressed: () => Navigator.pop(context, false),
+                        child: const Text('Keep editing')),
+                    TextButton(
+                        onPressed: () => Navigator.pop(context, true),
+                        child: const Text('Discard changes')),
+                  ],
+                )) ??
+        false;
+  }
+
+  Future<void> _replace(CollageTemplate template,
+      {SavedCollageVersion? saved}) async {
+    final overlay = await loadCollageOverlay(template);
+    _assertSession();
+    if (!mounted) {
+      overlay?.dispose();
+      return;
+    }
+    if (overlay != null) _images.add(overlay);
+    setState(() {
+      _template = template;
+      _cloudTemplateId = null;
+      _saved = saved;
+      _overlay = overlay;
+      _placements.clear();
+      _formEpoch++;
+      _dirty = saved == null;
+      _invalidDesign = false;
+      _error = null;
+      _status =
+          saved == null ? null : 'Opened saved version ${saved.revision}.';
+    });
+  }
+
+  Future<void> _preset(bool graduation) async {
+    if (!await _discard()) return;
+    await _run(() => _replace(CollageTemplate.preset(graduation: graduation)));
+  }
+
+  Future<void> _save() => _run(() async {
+        final store = _store ?? await CollageStore.open();
+        final saved =
+            await store.save(_template, templateId: _saved?.templateId);
+        final library = await store.versions();
+        if (mounted) {
+          setState(() {
+            _store = store;
+            _saved = saved;
+            _library = library;
+            _dirty = false;
+            _status =
+                'Saved private version ${saved.revision}. Previous versions stay unchanged.';
+          });
+        }
+      });
+
+  Future<void> _cloudRefresh() => _run(() async {
+        final store = _store ?? await CollageStore.open();
+        final versions = await CollageCloudService(store).list();
+        if (mounted) {
+          setState(() {
+            _store = store;
+            _cloudLibrary = versions;
+          });
+        }
+      });
+
+  Future<void> _cloudSave() => _run(() async {
+        final store = _store ?? await CollageStore.open();
+        final service = CollageCloudService(store);
+        final saved =
+            await service.saveDraft(_template, templateId: _cloudTemplateId);
+        final versions = await service.list();
+        if (mounted) {
+          setState(() {
+            _store = store;
+            _cloudTemplateId = saved.templateId;
+            _cloudLibrary = versions;
+            _status =
+                'Saved private Cloud draft version ${saved.versionNumber}. No gallery publication or product changes.';
+          });
+        }
+      });
+
+  Future<void> _import() async {
+    if (!await _discard()) return;
+    await _run(() async {
+      final picked = await FilePicker.platform.pickFiles(
+          type: FileType.custom,
+          allowedExtensions: ['json'],
+          dialogTitle: 'Import collage template');
+      final path = picked?.files.single.path;
+      if (path == null) return;
+      final file = File(path);
+      if (await file.length() > CollageTemplate.maxTemplateBytes) {
