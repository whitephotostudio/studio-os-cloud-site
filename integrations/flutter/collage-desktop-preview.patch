+++ b/test/collage_template_test.dart
@@ -0,0 +1,83 @@
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:whitephoto_studio_app/models/collage_template.dart';
+
+void main() {
+  test('portable v1 presets, crop and dimensions match the Cloud contract', () {
+    final template = CollageTemplate.preset();
+    expect(template.name, 'Three favourite moments');
+    expect(template.slots.map((slot) => slot.id), ['left', 'centre', 'right']);
+    expect(template.slots[1].number('y'), .07);
+    expect([template.pixelWidth, template.pixelHeight], [3000, 2400]);
+    final grad = CollageTemplate.preset(graduation: true);
+    expect(grad.slots.map((slot) => slot.id), ['main', 'inset']);
+    expect([grad.pixelWidth, grad.pixelHeight], [2400, 3000]);
+    final crop = collageCrop(4000, 6000, 1000, 1000, zoom: 2, x: .25, y: .75);
+    expect([crop.left, crop.top, crop.width, crop.height],
+        [500, 3000, 2000, 2000]);
+    expect(collageResolution(template, template.slots.first, 4000, 6000), 1209);
+  });
+
+  test(
+      'legacy template round trip excludes student details, paths and unknown fields',
+      () {
+    final raw = CollageTemplate.preset().toJson()
+      ..remove('bleedInches')
+      ..remove('safeInsetInches')
+      ..addAll({
+        'studentName': 'Secret Student',
+        'photos': ['/private/student.jpg'],
+        'price': 1,
+        'ownerId': 'attacker'
+      });
+    (raw['slots'] as List).first['photoUrl'] =
+        'https://untrusted.invalid/portrait.jpg';
+    final parsed = CollageTemplate.parse(raw);
+    final json = parsed.exportJson();
+    expect(parsed.bleedInches, 0);
+    expect(parsed.safeInsetInches, .125);
+    expect(json, isNot(contains('Secret')));
+    expect(json, isNot(contains('private')));
+    expect(json, isNot(contains('https:')));
+    expect(json, isNot(contains('price')));
+    expect(CollageTemplate.decode(json).toJson(), parsed.toJson());
+  });
+
+  test('bleed adds pixels around trim and preserves border design', () {
+    final raw = CollageTemplate.preset().toJson()..['bleedInches'] = .125;
+    (raw['slots'] as List).first['border'] = {
+      'color': '#ff0000',
+      'widthInches': .05
+    };
+    final template = CollageTemplate.parse(raw);
+    expect([template.pixelWidth, template.pixelHeight], [3075, 2475]);
+    expect(
+        CollageTemplate.decode(template.exportJson())
+            .slots
+            .first
+            .value['border'],
+        {'color': '#ff0000', 'widthInches': .05});
+    (template.slots.first.value['border'] as Map)['color'] = '#000000';
+    expect((template.slots.first.value['border'] as Map)['color'], '#ff0000');
+  });
+
+  test('malformed bounds, remote artwork and duplicate spaces fail closed', () {
+    for (final edit in <void Function(Map<String, dynamic>)>[
+      (t) => t['version'] = 2,
+      (t) => t['widthInches'] = double.nan,
+      (t) => t['overlay'] = 'https://example.invalid/art.png',
+      (t) => t['bleedInches'] = -.01,
+      (t) => (t['slots'] as List)[0]['x'] = .9,
+      (t) => (t['slots'] as List)[1]['id'] = 'left',
+      (t) => (t['slots'] as List)[0]
+          ['border'] = {'color': '#ffffff', 'widthInches': 1},
+    ]) {
+      final raw = CollageTemplate.preset().toJson();
+      edit(raw);
+      expect(() => CollageTemplate.parse(raw), throwsFormatException);
+    }
+    expect(() => CollageTemplate.decode(jsonEncode({'version': 1})),
+        throwsFormatException);
+  });
+}
