+import 'package:flutter_test/flutter_test.dart';
+import 'package:whitephoto_studio_app/services/package_sync_service.dart';
+
+void main() {
+  const versionId = '22222222-2222-4222-8222-222222222222';
+  Map<String, dynamic> ordinary({int quantity = 1, int price = 2000}) => {
+        'name': 'Studio package',
+        'price_cents': price,
+        'category': 'package',
+        'active': true,
+        'items': [
+          {'name': '8x10', 'qty': quantity, 'type': 'print'}
+        ],
+      };
+  Map<String, dynamic> cloudCollage({int price = 2000}) => {
+        ...ordinary(price: price),
+        'category': 'print',
+        'items': [
+          {
+            'name': '8x10',
+            'qty': 1,
+            'type': 'print',
+            'collage': {'templateVersionId': versionId}
+          },
+          {'name': '5x7', 'qty': 2, 'type': 'print'},
+        ],
+      };
+
+  test(
+      'repeated native price pushes preserve Cloud collage configuration and mixed children',
+      () {
+    final cloud = cloudCollage();
+    final staleLocal = {...ordinary(price: 2400), 'active': false};
+    final first = PriceSheetCatalogSync.mergeValues(
+        desired: staleLocal, existing: cloud, baseline: ordinary());
+    expect(first['items'], cloud['items']);
+    expect(first['category'], 'print');
+    expect(first['price_cents'], 2400);
+    expect(first['active'], false);
+    // A prior successful push refreshed metadata but not the old editor's item
+    // list. It cannot turn that old list into a collage removal on push two.
+    final second = PriceSheetCatalogSync.mergeValues(
+        desired: staleLocal, existing: first, baseline: first);
+    expect(second['items'], cloud['items']);
+    expect(second['category'], 'print');
+    expect(second['price_cents'], 2400);
+    ((second['items'] as List).first['collage'] as Map)['templateVersionId'] =
+        'changed';
+    expect(
+        ((cloud['items'] as List).first['collage'] as Map)['templateVersionId'],
+        versionId);
+    expect(
+        ((first['items'] as List).first['collage'] as Map)['templateVersionId'],
+        versionId);
+  });
+
+  test('ordinary package edits retain existing three-way item merge behavior',
+      () {
+    final changed = ordinary(quantity: 3, price: 2600);
+    final merged = PriceSheetCatalogSync.mergeValues(
+        desired: changed, existing: ordinary(), baseline: ordinary());
+    expect(merged['items'], changed['items']);
+    expect(merged['price_cents'], 2600);
+    expect(merged['category'], 'package');
+  });
+
+  test('protecting collage structure does not bypass price conflict checks',
+      () {
+    expect(
+        () => PriceSheetCatalogSync.mergeValues(
+            desired: ordinary(price: 2400),
+            existing: cloudCollage(price: 2600),
+            baseline: ordinary()),
+        throwsStateError);
+    expect(
+        () => PriceSheetCatalogSync.mergeValues(
+            desired: ordinary(price: 2400), existing: cloudCollage()),
+        throwsStateError);
+  });
+}
