+              .where((p) =>
+                  p.id == receipt.product.id &&
+                  p.active &&
+                  p.profileId == _profileId)
+              .firstOrNull;
+          _productId = currentProduct?.id;
+          _itemIndex = (currentProduct?.items ?? <dynamic>[])
+              .asMap()
+              .entries
+              .where((entry) =>
+                  entry.value is Map &&
+                  entry.value['collage'] is Map &&
+                  entry.value['collage']['templateVersionId'] ==
+                      receipt.version.id)
+              .map((entry) => entry.key)
+              .firstOrNull;
+          _status =
+              'Published version ${receipt.version.versionNumber}: ${receipt.product.name} • ${_catalog!.currency} ${formatCollagePrice(receipt.product.priceCents)}. Each collage copy has independent photo selections.';
+        });
+      }
+    } catch (_) {
+      final pending = await _service.pending();
+      if (mounted) setState(() => _pending = pending);
+      rethrow;
+    }
+  }
+
+  Future<void> _reviewPending() async {
+    final command = _pending;
+    if (command == null || _busy) return;
+    final remove = await showDialog<bool>(
+        context: context,
+        builder: (context) => AlertDialog(
+                title: const Text('Review unconfirmed publication'),
+                content: Text(
+                    'Cloud may already have saved “${command.name}”. Review the refreshed products and versions before removing this local retry record. Retrying the saved publication safely reuses its original identity. Removing the record does not withdraw a Cloud product; another publication creates a new request.'),
+                actions: [
+                  TextButton(
+                      onPressed: () => Navigator.pop(context, false),
+                      child: const Text('Keep retry record')),
+                  TextButton(
+                      onPressed: () => Navigator.pop(context, true),
+                      child: const Text('Remove local retry record'))
+                ]));
+    if (remove != true) return;
+    await _run(() async {
+      await _service.abandon(command);
+      await _load();
+      if (mounted) {
+        setState(() => _status =
+            'Removed local retry record. Saved Cloud products and versions are unchanged.');
+      }
+    });
+  }
+
+  Future<void> _withdraw() => _run(() async {
+        final id = _withdrawId;
+        if (id == null) {
+          throw const FormatException(
+              'Choose a published version to withdraw.');
+        }
+        final count = await widget.cloud.withdraw(id);
+        await _load();
+        if (mounted) {
+          setState(() => _status =
+              'Withdrew version from $count gallery assignments. Purchased order snapshots stay unchanged.');
+        }
+      });
+
