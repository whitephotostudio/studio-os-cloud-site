+                                      }
+                                    })
+                                : null),
+                      _publicationSummary(catalog, product),
+                      FilledButton(
+                          key: const ValueKey('collage-commerce-publish'),
+                          onPressed:
+                              enabled && _selected.isNotEmpty ? _publish : null,
+                          child:
+                              const Text('Publish new version and save price')),
+                      const Divider(height: 30),
+                      DropdownButtonFormField<String>(
+                          key: ValueKey(
+                              'collage-commerce-withdraw-${_versions.where((v) => v.canWithdraw).length}-${_withdrawId ?? ''}'),
+                          initialValue: _withdrawId,
+                          isExpanded: true,
+                          decoration: const InputDecoration(
+                              labelText: 'Published version to withdraw'),
+                          items: [
+                            for (final version
+                                in _versions.where((v) => v.canWithdraw))
+                              DropdownMenuItem(
+                                  value: version.id,
+                                  child: Text(
+                                      '${version.template.name} • v${version.versionNumber}'))
+                          ],
+                          onChanged: enabled
+                              ? (value) => setState(() => _withdrawId = value)
+                              : null),
+                      TextButton(
+                          key: const ValueKey('collage-commerce-withdraw'),
+                          onPressed:
+                              enabled && _withdrawId != null ? _withdraw : null,
+                          child: const Text('Withdraw gallery availability')),
+                    ],
+                  ]))),
+          actions: [
+            TextButton(
+                key: const ValueKey('collage-commerce-refresh'),
+                onPressed: _busy || _accountChanged ? null : _refresh,
+                child: const Text('Refresh saved state')),
+            TextButton(
+                onPressed:
+                    _busy ? null : () => Navigator.of(context).pop(_receipt),
+                child: const Text('Close'))
+          ],
+        ));
+  }
+}
