@@ -0,0 +1,103 @@
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:image/image.dart' as img;
+import 'package:whitephoto_studio_app/models/collage_template.dart';
+import 'package:whitephoto_studio_app/services/collage_renderer.dart';
+
+void main() {
+  testWidgets('EXIF portrait orientation is normalized before crop calculation',
+      (tester) async {
+    await tester.runAsync(() async {
+      final source = img.Image(width: 60, height: 30);
+      img.fill(source, color: img.ColorRgb8(255, 0, 0));
+      source.exif.imageIfd.orientation = 6;
+      final decoded =
+          await decodeCollageImage(Uint8List.fromList(img.encodeJpg(source)));
+      expect([decoded.width, decoded.height], [30, 60]);
+      decoded.dispose();
+    });
+  });
+
+  testWidgets(
+      'preview and 300ppi output share independent crops, layering, bleed and borders',
+      (tester) async {
+    await tester.runAsync(() async {
+      final source = img.Image(width: 120, height: 40);
+      img.fill(source, color: img.ColorRgb8(255, 0, 0));
+      img.fillRect(source,
+          x1: 60, y1: 0, x2: 119, y2: 39, color: img.ColorRgb8(0, 0, 255));
+      final image =
+          await decodeCollageImage(Uint8List.fromList(img.encodePng(source)));
+      final artwork = img.Image(width: 100, height: 100, numChannels: 4);
+      img.fill(artwork, color: img.ColorRgba8(0, 0, 0, 0));
+      img.fillRect(artwork,
+          x1: 5, y1: 5, x2: 20, y2: 20, color: img.ColorRgba8(0, 255, 0, 255));
+      final template = CollageTemplate.parse({
+        'version': 1,
+        'name': 'Renderer fixture',
+        'widthInches': 4,
+        'heightInches': 4,
+        'background': '#ffdd00',
+        'ink': '#000000',
+        'bleedInches': .125,
+        'overlay':
+            'data:image/png;base64,${base64Encode(img.encodePng(artwork))}',
+        'slots': [
+          {
+            'id': 'left',
+            'label': 'Left',
+            'x': .1,
+            'y': .1,
+            'width': .35,
+            'height': .6,
+            'border': {'color': '#ffffff', 'widthInches': .05}
+          },
+          {
+            'id': 'right',
+            'label': 'Right',
+            'x': .55,
+            'y': .1,
+            'width': .35,
+            'height': .6
+          },
+        ],
+        'caption': {'x': .5, 'y': .8, 'size': .02},
+      });
+      final overlay = await loadCollageOverlay(template);
+      final placements = {
+        'left': CollagePlacement(image, 'same-original.png', x: 0),
+        'right': CollagePlacement(image, 'same-original.png', x: 1),
+      };
+      for (final size in <int?>[510, null]) {
+        final output = img.decodePng(await renderCollagePng(
+            template, placements, [],
+            overlay: overlay, previewWidth: size))!;
+        expect(output.width, size ?? 1275);
+        expect(output.height, size ?? 1275);
+        List<int> at(double x, double y) {
+          final scale = output.width / 4.25;
+          final pixel = output.getPixel(((.125 + x * 4) * scale).floor(),
+              ((.125 + y * 4) * scale).floor());
+          return [pixel.r.toInt(), pixel.g.toInt(), pixel.b.toInt()];
+        }
+
+        expect(at(.12, .12), [0, 255, 0],
+            reason: 'artwork layers above photos');
+        expect(at(.25, .4), [255, 0, 0], reason: 'first copy uses left crop');
+        expect(at(.65, .4), [0, 0, 255],
+            reason: 'same photo can use independent right crop');
+        expect(at(.102, .4), [255, 255, 255],
+            reason: 'physical border width stays inside opening');
+        final bleed = output.getPixel(0, 0);
+        expect(
+            [bleed.r.toInt(), bleed.g.toInt(), bleed.b.toInt()], [255, 221, 0]);
+      }
+      image.dispose();
+      overlay?.dispose();
+      await expectLater(renderCollagePng(template, {}, [], previewWidth: 300),
+          throwsStateError);
+    });
+  });
+}
