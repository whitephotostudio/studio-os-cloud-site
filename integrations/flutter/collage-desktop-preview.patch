@@ -0,0 +1,228 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:isolate';
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:image/image.dart' as img;
+
+import '../models/collage_template.dart';
+
+/// Memory-only test selection. Never serialize local paths or student text into
+/// a reusable template or treat a preview image as a purchased order item.
+class CollagePlacement {
+  const CollagePlacement(this.image, this.filename,
+      {this.zoom = 1, this.x = .5, this.y = .5});
+  final ui.Image image;
+  final String filename;
+  final double zoom;
+  final double x;
+  final double y;
+
+  CollagePlacement cropped({double? zoom, double? x, double? y}) =>
+      CollagePlacement(image, filename,
+          zoom: zoom ?? this.zoom, x: x ?? this.x, y: y ?? this.y);
+}
+
+/// Normalize EXIF before either preview or export. The same upright pixels and
+/// the same source crop are used at every output scale.
+Future<ui.Image> decodeCollageImage(Uint8List bytes) async {
+  final upright = await Isolate.run(() {
+    final decoder = img.findDecoderForData(bytes);
+    final info = decoder?.startDecode(bytes);
+    if (info == null || info.width * info.height > 100000000) {
+      throw const FormatException(
+          'Use a readable PNG/JPEG up to 100 megapixels.');
+    }
+    final decoded = decoder!.decode(bytes, frame: 0);
+    if (decoded == null) {
+      throw const FormatException('The image could not be decoded.');
+    }
+    return Uint8List.fromList(img.encodePng(img.bakeOrientation(decoded)));
+  });
+  final codec = await ui.instantiateImageCodec(upright);
+  try {
+    return (await codec.getNextFrame()).image;
+  } finally {
+    codec.dispose();
+  }
+}
+
+Future<ui.Image> loadCollagePhoto(String path) async {
+  final file = File(path);
+  if (await file.length() > 150 * 1024 * 1024) {
+    throw const FormatException('Test photos must be smaller than 150 MB.');
+  }
+  return decodeCollageImage(await file.readAsBytes());
+}
+
+Future<ui.Image?> loadCollageOverlay(CollageTemplate template) async {
+  final overlay = template.overlay;
+  if (overlay == null) return null;
+  return decodeCollageImage(base64Decode(overlay.split(',').last));
+}
+
+Color collageColor(String hex) =>
+    Color(0xff000000 | int.parse(hex.substring(1), radix: 16));
+
+Rect collageTrimRect(CollageTemplate template, Size canvasSize) {
+  final scale =
+      canvasSize.width / (template.widthInches + 2 * template.bleedInches);
+  final bleed = template.bleedInches * scale;
+  return Rect.fromLTWH(bleed, bleed, template.widthInches * scale,
+      template.heightInches * scale);
+}
+
+/// One draw routine powers the native preview and full-resolution PNG export.
+void paintCollage(Canvas canvas, Size size, CollageTemplate template,
+    Map<String, CollagePlacement> placements, List<String> captions,
+    {ui.Image? overlay, bool placeholders = true, bool guides = false}) {
+  final trim = collageTrimRect(template, size);
+  canvas.drawRect(
+      Offset.zero & size, Paint()..color = collageColor(template.background));
+  for (final slot in template.slots) {
+    final rect = slot.inRect(trim);
+    final placement = placements[slot.id];
+    if (placement == null) {
+      if (!placeholders) throw StateError('Choose a photo for ${slot.label}.');
+      canvas.drawRect(rect, Paint()..color = const Color(0xffe9edf3));
+      _text(canvas, slot.label, rect.center,
+          width: rect.width * .9,
+          fontSize: trim.width * .018,
+          color: const Color(0xff566176),
+          centerVertically: true);
+    } else {
+      final image = placement.image;
+      final source = collageCrop(image.width.toDouble(),
+          image.height.toDouble(), rect.width, rect.height,
+          zoom: placement.zoom, x: placement.x, y: placement.y);
+      canvas.drawImageRect(
+          image, source, rect, Paint()..filterQuality = FilterQuality.high);
+    }
+    final border = slot.value['border'] as Map?;
+    if (border != null) {
+      final width = (border['widthInches'] as num).toDouble() *
+          trim.width /
+          template.widthInches;
+      if (width > 0) {
+        canvas.drawRect(
+            rect.deflate(width / 2),
+            Paint()
+              ..color = collageColor(border['color'] as String)
+              ..style = PaintingStyle.stroke
+              ..strokeWidth = width);
+      }
+    }
+  }
+  if (overlay != null) {
+    canvas.drawImageRect(
+        overlay,
+        Rect.fromLTWH(
+            0, 0, overlay.width.toDouble(), overlay.height.toDouble()),
+        trim,
+        Paint()..filterQuality = FilterQuality.high);
+  }
+  final caption = template.caption;
+  final x = (caption['x'] as num).toDouble();
+  final y = (caption['y'] as num).toDouble();
+  final fontSize = trim.width * (caption['size'] as num);
+  final textWidth =
+      (2 * (x < .5 ? x : 1 - x) * trim.width * .95).clamp(1.0, trim.width);
+  for (var i = 0; i < captions.length && i < 3; i++) {
+    final value =
+        captions[i].length > 100 ? captions[i].substring(0, 100) : captions[i];
+    _text(
+        canvas,
+        value,
+        Offset(trim.left + x * trim.width,
+            trim.top + y * trim.height + i * fontSize * 1.5),
+        width: textWidth.toDouble(),
+        fontSize: fontSize.toDouble(),
+        color: collageColor(template.ink),
+        bold: true);
+  }
+  if (guides) {
+    final paint = Paint()
+      ..color = Colors.red.withValues(alpha: .7)
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 1;
+    canvas.drawRect(trim, paint);
+    final safe = template.safeInsetInches * trim.width / template.widthInches;
+    canvas.drawRect(
+        trim.deflate(safe), paint..color = Colors.blue.withValues(alpha: .6));
+  }
+}
+
+void _text(Canvas canvas, String value, Offset at,
+    {required double width,
+    required double fontSize,
+    required Color color,
+    bool bold = false,
+    bool centerVertically = false}) {
+  final painter = TextPainter(
+    text: TextSpan(
+        text: value,
+        style: TextStyle(
+            fontFamily: 'Arial',
+            fontSize: fontSize,
+            fontWeight: bold ? FontWeight.bold : FontWeight.normal,
+            color: color,
+            height: 1)),
+    textAlign: TextAlign.center,
+    textDirection: TextDirection.ltr,
+    maxLines: 1,
+  )..layout();
+  // Browser Canvas.fillText(maxWidth) scales long captions horizontally. Match
+  // that behavior rather than truncating names in the native renderer.
+  final scaleX = painter.width > width ? width / painter.width : 1.0;
+  canvas.save();
+  canvas.translate(at.dx, at.dy - (centerVertically ? painter.height / 2 : 0));
+  canvas.scale(scaleX, 1);
+  painter.paint(canvas, Offset(-painter.width / 2, 0));
+  canvas.restore();
+  painter.dispose();
+}
+
+Future<Uint8List> renderCollagePng(CollageTemplate template,
+    Map<String, CollagePlacement> placements, List<String> captions,
+    {ui.Image? overlay, int? previewWidth, bool placeholders = false}) async {
+  final width = previewWidth ?? template.pixelWidth;
+  final height = previewWidth == null
+      ? template.pixelHeight
+      : (width * template.pixelHeight / template.pixelWidth).round();
+  final recorder = ui.PictureRecorder();
+  final canvas = Canvas(recorder);
+  paintCollage(canvas, Size(width.toDouble(), height.toDouble()), template,
+      placements, captions,
+      overlay: overlay, placeholders: placeholders);
+  final picture = recorder.endRecording();
+  try {
+    final image = await picture.toImage(width, height);
+    try {
+      final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
+      if (bytes == null) throw StateError('PNG export failed.');
+      return bytes.buffer.asUint8List();
+    } finally {
+      image.dispose();
+    }
+  } finally {
+    picture.dispose();
+  }
+}
+
+class CollageCanvas extends CustomPainter {
+  const CollageCanvas(this.template, this.placements, this.captions,
+      {this.overlay, this.guides = true});
+  final CollageTemplate template;
+  final Map<String, CollagePlacement> placements;
+  final List<String> captions;
+  final ui.Image? overlay;
+  final bool guides;
+  @override
+  void paint(Canvas canvas, Size size) =>
+      paintCollage(canvas, size, template, placements, captions,
+          overlay: overlay, guides: guides);
+  @override
+  bool shouldRepaint(covariant CollageCanvas oldDelegate) => true;
+}
