+        }
+      });
+
+  String _safeName() =>
+      _template.name.replaceAll(RegExp(r'[^a-zA-Z0-9_-]+'), '_');
+
+  /// File-picker-selected exports only. Atomic replacement avoids a partial PNG
+  /// or JSON on failure and never writes into capture/order data automatically.
+  Future<void> _writeExport(File target, List<int> bytes) async {
+    final staged = File(
+        '${target.path}.collage-tmp-${DateTime.now().microsecondsSinceEpoch}');
+    try {
+      await staged.writeAsBytes(bytes, flush: true);
+      _assertSession();
+      await staged.rename(target.path);
+    } finally {
+      if (await staged.exists()) await staged.delete();
+    }
+  }
+
+  Future<void> _artwork() => _run(() async {
+        final picked = await FilePicker.platform.pickFiles(
+            type: FileType.custom,
+            allowedExtensions: ['png', 'jpg', 'jpeg'],
+            dialogTitle: 'Choose clean collage artwork');
+        final path = picked?.files.single.path;
+        if (path == null) return;
+        final file = File(path);
+        if (await file.length() > 8 * 1024 * 1024) {
+          throw const FormatException('Artwork must be smaller than 8 MB.');
+        }
+        final bytes = await file.readAsBytes();
+        final image = await decodeCollageImage(bytes);
+        _assertSession();
+        if (!mounted) {
+          image.dispose();
+          return;
+        }
+        _images.add(image);
+        final mime = p.extension(path).toLowerCase() == '.png' ? 'png' : 'jpeg';
+        final next = _template.changed(
+            {'overlay': 'data:image/$mime;base64,${base64Encode(bytes)}'});
+        setState(() {
+          _overlay = image;
+          _template = next;
+          _dirty = true;
+          _formEpoch++;
+        });
+      });
