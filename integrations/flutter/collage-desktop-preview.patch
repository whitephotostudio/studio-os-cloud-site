+import 'package:flutter/material.dart';
+
+import '../models/collage_commerce.dart';
+import '../models/collage_template.dart';
+import '../services/collage_cloud_service.dart';
+import '../services/collage_commerce_service.dart';
+import '../storage/account_scope.dart';
+
+/// Explicit desktop publishing dialog. No network action runs until it is opened.
+class CollageCommercePanel extends StatefulWidget {
+  const CollageCommercePanel(
+      {super.key,
+      required this.cloud,
+      required this.design,
+      this.templateId,
+      this.onPublished});
+  final CollageCloudService cloud;
+  final CollageTemplate design;
+  final String? templateId;
+  final ValueChanged<CollagePublicationReceipt>? onPublished;
+  @override
+  State<CollageCommercePanel> createState() => _CollageCommercePanelState();
+}
+
+class _CollageCommercePanelState extends State<CollageCommercePanel> {
+  late final CollageCommerceService _service =
+      CollageCommerceService(widget.cloud);
+  CollageCommerceState? _catalog;
+  List<CloudCollageVersion> _versions = [];
+  PendingCollagePublication? _pending;
+  final _name = TextEditingController();
+  final _price = TextEditingController();
+  String? _profileId, _productId, _withdrawId;
+  int? _itemIndex;
+  int _copies = 1;
+  final _selected = <String>{};
+  bool _busy = false, _accountChanged = false;
+  String? _error, _status;
+  CollagePublicationReceipt? _receipt;
+
+  @override
+  void initState() {
+    super.initState();
+    _name.text = widget.design.name;
+    AccountScope.sessionRevision.addListener(_sessionChanged);
+    _refresh();
+  }
+
+  @override
+  void dispose() {
+    AccountScope.sessionRevision.removeListener(_sessionChanged);
+    _name.dispose();
+    _price.dispose();
+    super.dispose();
+  }
+
+  void _sessionChanged() {
+    if (!mounted) return;
+    setState(() {
+      _accountChanged = true;
+      _catalog = null;
+      _versions = [];
+      _pending = null;
+      _selected.clear();
+      _name.clear();
+      _price.clear();
+      _error = 'The studio account changed. Reopen Collages.';
+    });
+  }
+
+  Future<void> _run(Future<void> Function() action) async {
+    if (_busy || _accountChanged) return;
+    setState(() {
+      _busy = true;
+      _error = null;
+      _status = null;
+    });
+    try {
+      widget.cloud.store.assertActive();
+      await action();
+    } catch (error) {
+      if (mounted) {
+        setState(
+            () => _error = error is FormatException ? error.message : '$error');
+      }
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _load() async {
+    final catalog = await widget.cloud.commerce();
+    final versions = await widget.cloud.list();
+    final pending = await _service.pending();
+    widget.cloud.store.assertActive();
+    if (!mounted) return;
+    setState(() {
+      _catalog = catalog;
+      _versions = versions;
+      _pending = pending;
+      if (!catalog.profiles.any((p) => p.id == _profileId)) {
+        _profileId = catalog.profiles.first.id;
+      }
+      final product = catalog.products
+          .where((p) =>
+              p.id == _productId && p.profileId == _profileId && p.active)
+          .firstOrNull;
+      if (product == null) {
+        _productId = null;
+        _itemIndex = null;
+      }
+      _selected.removeWhere((key) => !catalog.galleries
+          .any((g) => g.key == key && g.profileId == _profileId));
+      if (!_versions.any((v) => v.id == _withdrawId && v.canWithdraw)) {
+        _withdrawId = null;
+      }
+    });
+  }
+
+  Future<void> _refresh() => _run(_load);
+  Future<void> _publish() => _run(() async {
+        final catalog = _catalog!;
+        final command = await _service.prepare(
+            catalog: catalog,
+            design: widget.design,
+            galleries: catalog.galleries
+                .where((g) => _selected.contains(g.key))
+                .toList(),
+            profileId: _profileId,
+            priceCents: parseCollagePriceCents(_price.text),
+            copyCount: _copies,
+            templateId: _receipt?.version.templateId ?? widget.templateId,
+            productId: _productId,
+            name: _name.text,
+            itemIndex: _itemIndex);
+        if (mounted) setState(() => _pending = command);
+        await _submit(command);
+      });
+  Future<void> _submit(PendingCollagePublication command) async {
+    try {
+      final receipt = await _service.submit(command);
+      widget.onPublished?.call(receipt);
+      if (mounted) {
+        setState(() {
+          _receipt = receipt;
+        });
+      }
