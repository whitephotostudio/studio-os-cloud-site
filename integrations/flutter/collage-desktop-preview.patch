+      final records = <Map<String, dynamic>>[];
+      final folder = await prepareNoritsuPrintBatch(
+          destinationPath:
+              '${output.path}/native-noritsu-${DateTime.now().microsecondsSinceEpoch}',
+          temporaryRoot: output,
+          prepare: (stage) async {
+            for (final order in resolved) {
+              for (final item in order.items) {
+                final jpeg = await renderVerifiedCollagePrintJpeg(item);
+                final dimensions = img.JpegDecoder().startDecode(jpeg)!;
+                final name = '${order.id}_${item.id}.jpg';
+                await File('$stage/$name').writeAsBytes(jpeg, flush: true);
+                records.add({
+                  'filename': name,
+                  'orderId': order.id,
+                  'itemId': item.id,
+                  'sha256': sha256.convert(jpeg).toString(),
+                  'width': dimensions.width,
+                  'height': dimensions.height,
+                  'productionReceipt': item.collageProductionReceipt!.toJson()
+                });
+              }
+            }
+            return records.length;
+          },
+          beforePublish: () =>
+              ensureCollageProductionReceiptsCurrent(resolved));
+      expect(records, isNotEmpty);
+      expect(
+          records.map((r) => r['itemId']).toSet(), hasLength(records.length));
+      await File('${output.path}/native-production-receipt.json')
+          .writeAsString(const JsonEncoder.withIndent('  ').convert({
+        'phase': 'native-production',
+        'outputDirectory': folder,
+        'printCount': records.length,
+        'prints': records,
+        'noPrinterInvoked': true
+      }));
+    }, timeout: const Timeout(Duration(minutes: 12)));
+  } else {
+    throw StateError('Choose publish, review or production fixture phase.');
+  }
+}
