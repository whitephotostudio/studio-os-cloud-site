+          child: Padding(
+              padding: const EdgeInsets.all(12),
+              child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    const Text('Publication summary',
+                        style: TextStyle(fontWeight: FontWeight.bold)),
+                    Text(
+                        '${product?.name ?? _name.text} • ${catalog.currency} ${_price.text} per product/package set'),
+                    Text(
+                        'Price sheet: ${catalog.profiles.firstWhere((p) => p.id == _profileId).name}'),
+                    Text(
+                        'Galleries: ${catalog.galleries.where((g) => _selected.contains(g.key)).map((g) => g.name).join(', ')}'),
+                    if (product != null) ...[
+                      const Text('Existing contents preserved:'),
+                      for (final entry in product.items.asMap().entries)
+                        if (entry.key != _itemIndex)
+                          Text(
+                              '${entry.value is Map ? entry.value['name'] ?? 'Item ${entry.key + 1}' : 'Item ${entry.key + 1}'} × ${entry.value is Map ? entry.value['qty'] ?? entry.value['quantity'] ?? 1 : 1}'),
+                    ],
+                    Text(
+                        'New collage: ${widget.design.name} × $_copies independent ${_copies == 1 ? 'copy' : 'copies'} per set.'),
+                    const Text(
+                        'Each parent purchase quantity adds another complete set, with separate collage selections.'),
+                  ])));
+
+  @override
+  Widget build(BuildContext context) {
+    final catalog = _catalog;
+    final enabled = !_busy && !_accountChanged && _pending == null;
