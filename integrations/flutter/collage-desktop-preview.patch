index 0000000..d2cdf7a
--- /dev/null
+++ b/lib/models/collage_template.dart
@@ -0,0 +1,261 @@
+import 'dart:convert';
+import 'dart:math' as math;
+import 'dart:ui';
+
+/// ECMAScript String.trim whitespace. Dart additionally removes U+0085, which
+/// would change valid Cloud template/caption hashes across the two clients.
+String collageTrim(String value) => value.replaceAll(
+    RegExp(
+        r'^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+|[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$'),
+    '');
+
+/// Shared portable v1 design contract. Personal text and test photos are never
+/// part of this document. Keep in sync with Cloud's lib/collage-template.ts.
+class CollageTemplate {
+  CollageTemplate._(this._value);
+
+  static const dpi = 300;
+  static const maxTemplateBytes = 12 * 1024 * 1024;
+  final Map<String, dynamic> _value;
+  String get name => _value['name'] as String;
+  double get widthInches => (_value['widthInches'] as num).toDouble();
+  double get heightInches => (_value['heightInches'] as num).toDouble();
+  String get background => _value['background'] as String;
+  String get ink => _value['ink'] as String;
+  String? get overlay => _value['overlay'] as String?;
+  double get bleedInches => (_value['bleedInches'] as num).toDouble();
+  double get safeInsetInches => (_value['safeInsetInches'] as num).toDouble();
+  List<CollageSlot> get slots => (_value['slots'] as List)
+      .map((slot) => CollageSlot(
+          Map<String, dynamic>.from(jsonDecode(jsonEncode(slot)) as Map)))
+      .toList(growable: false);
+  Map<String, dynamic> get caption =>
+      Map<String, dynamic>.from(_value['caption'] as Map);
+  int get pixelWidth => ((widthInches + 2 * bleedInches) * dpi).round();
+  int get pixelHeight => ((heightInches + 2 * bleedInches) * dpi).round();
+
+  Map<String, dynamic> toJson() =>
+      Map<String, dynamic>.from(jsonDecode(jsonEncode(_value)) as Map);
+  String exportJson() => const JsonEncoder.withIndent('  ').convert(toJson());
+
+  CollageTemplate changed(Map<String, dynamic> changes) =>
+      CollageTemplate.parse({...toJson(), ...changes});
+
+  static CollageTemplate decode(String text) {
+    if (utf8.encode(text).length > maxTemplateBytes) {
+      throw const FormatException('Template file exceeds 12 MB.');
+    }
+    return parse(jsonDecode(text));
+  }
+
+  static CollageTemplate parse(Object? value) {
+    Map<String, dynamic> record(Object? value) {
+      if (value is! Map) {
+        throw const FormatException('Invalid template structure.');
+      }
+      return Map<String, dynamic>.from(value);
+    }
+
+    bool finite(Object? value, double min, double max) =>
+        value is num && value.isFinite && value >= min && value <= max;
+    bool colour(Object? value) =>
+        value is String && RegExp(r'^#[a-fA-F0-9]{6}$').hasMatch(value);
+
+    final t = record(value);
+    if (t['version'] != 1) {
+      throw const FormatException('Unsupported template version.');
+    }
+    final name = t['name'];
+    if (name is! String || collageTrim(name).isEmpty || name.length > 100) {
+      throw const FormatException(
+          'Enter a template name, up to 100 characters.');
+    }
+    final width = t['widthInches'];
+    final height = t['heightInches'];
+    if (!finite(width, 4, 30) ||
+        !finite(height, 4, 30) ||
+        (width as num) * (height as num) > 600) {
+      throw const FormatException(
+          'Print dimensions must be 4–30 inches, up to 600 square inches.');
+    }
+    if (!colour(t['background']) || !colour(t['ink'])) {
+      throw const FormatException(
+          'Use six-digit hex colours, such as #ffffff.');
+    }
+    final overlay = t['overlay'];
+    if (overlay != null &&
+        (overlay is! String ||
+            overlay.length > maxTemplateBytes ||
+            !RegExp(r'^data:image/(png|jpeg);base64,[A-Za-z0-9+/]+=*$')
+                .hasMatch(overlay))) {
+      throw const FormatException('Artwork must be an embedded PNG or JPEG.');
+    }
+    final bleed = t['bleedInches'] ?? 0;
+    final safe = t['safeInsetInches'] ?? .125;
+    if (!finite(bleed, 0, .5) || !finite(safe, 0, .5)) {
+      throw const FormatException('Bleed and safe inset must be 0–0.5 inches.');
+    }
+    final rawSlots = t['slots'];
+    if (rawSlots is! List || rawSlots.isEmpty || rawSlots.length > 8) {
+      throw const FormatException('A collage needs 1–8 photo spaces.');
+    }
+    final ids = <String>{};
+    final slots = rawSlots.map((value) {
+      final s = record(value);
+      final id = s['id'];
+      if (id is! String ||
+          !RegExp(r'^[a-zA-Z0-9_-]{1,64}$').hasMatch(id) ||
+          !ids.add(id)) {
+        throw const FormatException('Photo spaces need unique IDs.');
+      }
+      final label = s['label'];
+      if (label is! String || collageTrim(label).isEmpty || label.length > 80) {
+        throw const FormatException('Enter a photo-space label.');
+      }
+      if (!finite(s['x'], 0, 1) ||
+          !finite(s['y'], 0, 1) ||
+          !finite(s['width'], .02, 1) ||
+          !finite(s['height'], .02, 1) ||
+          (s['x'] as num) + (s['width'] as num) > 1.000001 ||
+          (s['y'] as num) + (s['height'] as num) > 1.000001) {
+        throw const FormatException('Keep every photo space inside the trim.');
+      }
+      final border = s['border'] == null ? null : record(s['border']);
+      if (border != null &&
+          (!colour(border['color']) ||
+              !finite(border['widthInches'], 0, .25))) {
+        throw const FormatException('Invalid photo border.');
+      }
+      return <String, dynamic>{
+        for (final key in ['id', 'label', 'x', 'y', 'width', 'height'])
+          key: s[key],
+        if (border != null)
+          'border': {
+            'color': border['color'],
+            'widthInches': border['widthInches'],
+          },
+      };
+    }).toList();
+    final c = record(t['caption']);
+    if (!finite(c['x'], 0, 1) ||
+        !finite(c['y'], 0, .9) ||
+        !finite(c['size'], .01, .06)) {
+      throw const FormatException('Keep the caption inside the trim.');
+    }
+    return CollageTemplate._({
+      'version': 1,
+      'name': collageTrim(name),
+      'widthInches': width,
+      'heightInches': height,
+      'background': t['background'],
+      'ink': t['ink'],
+      'overlay': overlay,
+      'bleedInches': bleed,
+      'safeInsetInches': safe,
+      'slots': slots,
+      'caption': {
+        for (final key in ['x', 'y', 'size']) key: c[key]
+      },
+    });
+  }
+
+  static CollageTemplate preset({bool graduation = false}) => parse({
+        'version': 1,
+        'name': graduation ? 'Graduation keepsake' : 'Three favourite moments',
+        'widthInches': graduation ? 8 : 10,
+        'heightInches': graduation ? 10 : 8,
+        'background': '#ffffff',
+        'ink': graduation ? '#14245b' : '#172033',
+        'overlay': null,
+        'slots': graduation
+            ? [
+                {
+                  'id': 'main',
+                  'label': 'Main portrait',
+                  'x': .07,
+                  'y': .055,
+                  'width': .75,
+                  'height': .67
+                },
+                {
+                  'id': 'inset',
+                  'label': 'Inset portrait',
+                  'x': .62,
+                  'y': .53,
+                  'width': .32,
+                  'height': .32
+                },
+              ]
+            : [
+                {
+                  'id': 'left',
+                  'label': 'Left photo',
+                  'x': .06,
+                  'y': .12,
+                  'width': .27,
+                  'height': .62
+                },
+                {
+                  'id': 'centre',
+                  'label': 'Centre photo',
+                  'x': .365,
+                  'y': .07,
+                  'width': .27,
+                  'height': .67
+                },
+                {
+                  'id': 'right',
+                  'label': 'Right photo',
+                  'x': .67,
+                  'y': .12,
+                  'width': .27,
+                  'height': .62
+                },
+              ],
+        'caption': {
+          'x': graduation ? .33 : .5,
+          'y': graduation ? .79 : .82,
+          'size': graduation ? .027 : .028
+        },
+      });
+}
+
+class CollageSlot {
+  const CollageSlot(this.value);
+  final Map<String, dynamic> value;
+  String get id => value['id'] as String;
+  String get label => value['label'] as String;
+  double number(String key) => (value[key] as num).toDouble();
+  Rect inRect(Rect trim) => Rect.fromLTWH(
+      trim.left + number('x') * trim.width,
+      trim.top + number('y') * trim.height,
+      number('width') * trim.width,
+      number('height') * trim.height);
+}
+
+/// The exact source crop used by both renderers. Positions run from 0 to 1.
+Rect collageCrop(double photoWidth, double photoHeight, double frameWidth,
+    double frameHeight,
+    {double zoom = 1, double x = .5, double y = .5}) {
+  if (![photoWidth, photoHeight, frameWidth, frameHeight]
+          .every((v) => v.isFinite && v > 0) ||
+      ![zoom, x, y].every((v) => v.isFinite)) {
+    throw const FormatException('Invalid image or crop dimensions.');
+  }
+  final scale = math.max(frameWidth / photoWidth, frameHeight / photoHeight) *
+      zoom.clamp(1, 3);
+  final width = math.min(photoWidth, frameWidth / scale);
+  final height = math.min(photoHeight, frameHeight / scale);
+  return Rect.fromLTWH((photoWidth - width) * x.clamp(0, 1),
+      (photoHeight - height) * y.clamp(0, 1), width, height);
+}
+
+int collageResolution(
+    CollageTemplate template, CollageSlot slot, double width, double height,
+    {double zoom = 1}) {
+  final frameWidth = template.widthInches * slot.number('width');
+  final frameHeight = template.heightInches * slot.number('height');
+  final crop = collageCrop(width, height, frameWidth, frameHeight, zoom: zoom);
+  return (math.min(crop.width / frameWidth, crop.height / frameHeight) + 1e-8)
+      .floor();
+}
