+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:whitephoto_studio_app/screens/collages_screen.dart';
+import 'package:whitephoto_studio_app/storage/account_scope.dart';
+import 'package:whitephoto_studio_app/storage/collage_store.dart';
+import 'package:whitephoto_studio_app/storage/local_store.dart';
+
+void main() {
+  setUpAll(() async {
+    final font = File('/System/Library/Fonts/Supplemental/Arial.ttf');
+    if (await font.exists()) {
+      final bytes = await font.readAsBytes();
+      await (FontLoader('Arial')
+            ..addFont(Future.value(ByteData.sublistView(bytes))))
+          .load();
+    }
+  });
+  late Directory root;
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('collage-native-ui-');
+    LocalStore.debugStorageRoot = root;
+    AccountScope.debugAccountId = 'fixture-collage-owner';
+  });
+  tearDown(() async {
+    LocalStore.debugStorageRoot = null;
+    AccountScope.debugAccountId = null;
+    await root.delete(recursive: true);
+  });
+
+  Future<void> settleIo(WidgetTester tester) async {
+    await tester
+        .runAsync(() => Future<void>.delayed(const Duration(milliseconds: 80)));
+    await tester.pump();
+  }
+
+  testWidgets(
+      'native preview switches layouts and saves/reopens immutable templates',
+      (tester) async {
+    tester.view.physicalSize = const Size(1440, 1100);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    final boundary = GlobalKey();
+    await tester.pumpWidget(MaterialApp(
+        theme: ThemeData(fontFamily: 'Arial'),
+        home: RepaintBoundary(key: boundary, child: const CollagesScreen())));
+    await settleIo(tester);
+    expect(find.text('DESIGN PREVIEW'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+    final preview = find.byKey(const ValueKey('collage-preview'));
+    expect(tester.getSize(preview).aspectRatio, closeTo(1.25, .001));
+    await tester.tap(find.text('Graduation'));
+    await tester.pump();
+    await settleIo(tester);
+    expect(tester.getSize(preview).aspectRatio, closeTo(.8, .001));
+    await tester.enterText(
+        find.byKey(const ValueKey('collage-field-1-Template name')),
+        'Graduation fixture');
+    await tester.pump();
+    await tester.tap(find.text('Save template'));
+    await tester.pump();
+    for (var attempt = 0;
+        attempt < 30 &&
+            find
+                .text(
+                    'Saved private version 1. Previous versions stay unchanged.')
+                .evaluate()
+                .isEmpty;
+        attempt++) {
+      await settleIo(tester);
+    }
+    expect(
+        find.text('Saved private version 1. Previous versions stay unchanged.'),
+        findsOneWidget);
+    final versions = await tester
+        .runAsync(() async => (await CollageStore.open()).versions());
+    expect(versions!.single.template.name, 'Graduation fixture');
+    expect(versions.single.template.slots, hasLength(2));
+    expect(tester.takeException(), isNull);
+    await tester.runAsync(() async {
+      final image = await (boundary.currentContext!.findRenderObject()
+              as RenderRepaintBoundary)
+          .toImage();
+      final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
+      await Directory('preview').create(recursive: true);
+      await File('preview/collages-native-graduation.png')
+          .writeAsBytes(bytes!.buffer.asUint8List());
+      image.dispose();
+    });
+    await tester.pumpWidget(MaterialApp(
+        theme: ThemeData(fontFamily: 'Arial'), home: const CollagesScreen()));
+    for (var attempt = 0;
+        attempt < 30 &&
+            find.byKey(const ValueKey('collage-library-1')).evaluate().isEmpty;
+        attempt++) {
+      await settleIo(tester);
+    }
+    await tester.tap(find.byKey(const ValueKey('collage-library-1')));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Graduation fixture • version 1').last);
+    await tester.pump();
+    await settleIo(tester);
+    expect(tester.getSize(preview).aspectRatio, closeTo(.8, .001));
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets(
+      'narrow native preview has no overflow and account changes clear private content',
+      (tester) async {
+    tester.view.physicalSize = const Size(390, 844);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    await tester.pumpWidget(const MaterialApp(home: CollagesScreen()));
+    await settleIo(tester);
+    expect(find.byKey(const ValueKey('collage-preview')), findsOneWidget);
+    expect(tester.takeException(), isNull);
+    AccountScope.debugAccountId = 'another-owner';
+    AccountScope.sessionRevision.value++;
+    await tester.pump();
+    expect(find.text('The studio account changed. Reopen Collages.'),
+        findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+}
