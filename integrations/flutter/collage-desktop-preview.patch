diff --git a/lib/storage/collage_store.dart b/lib/storage/collage_store.dart
new file mode 100644
index 0000000..4bcc902
--- /dev/null
+++ b/lib/storage/collage_store.dart
@@ -0,0 +1,139 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:uuid/uuid.dart';
+
+import '../models/collage_template.dart';
+import 'account_scope.dart';
+import 'atomic_json_store.dart';
+import 'local_store.dart';
+
+class SavedCollageVersion {
+  const SavedCollageVersion(
+      {required this.templateId,
+      required this.versionId,
+      required this.revision,
+      required this.savedAt,
+      required this.template});
+  final String templateId;
+  final String versionId;
+  final int revision;
+  final DateTime savedAt;
+  final CollageTemplate template;
+
+  Map<String, dynamic> toJson() => {
+        'templateId': templateId,
+        'versionId': versionId,
+        'revision': revision,
+        'savedAt': savedAt.toUtc().toIso8601String(),
+        'template': template.toJson(),
+        'sha256': sha256.convert(utf8.encode(template.exportJson())).toString(),
+      };
+
+  static SavedCollageVersion fromJson(Map value) {
+    final template = CollageTemplate.parse(value['template']);
+    if (value['sha256'] !=
+        sha256.convert(utf8.encode(template.exportJson())).toString()) {
+      throw const FormatException(
+          'A saved collage version failed its integrity check.');
+    }
+    return SavedCollageVersion(
+        templateId: value['templateId'] as String,
+        versionId: value['versionId'] as String,
+        revision: value['revision'] as int,
+        savedAt: DateTime.parse(value['savedAt'] as String),
+        template: template);
+  }
+}
+
+/// Separate from class composites. Captures the account and session before
+/// asynchronous work; an account switch can never redirect a pending write.
+class CollageStore {
+  CollageStore._(this._root, this.ownerId, this._session);
+  final Directory _root;
+  final String ownerId;
+  final int _session;
+
+  static Future<CollageStore> open() async {
+    final owner = AccountScope.currentAccountId;
+    final session = AccountScope.sessionRevision.value;
+    if (owner == null) {
+      throw StateError('Sign in to save private collage templates.');
+    }
+    final store = CollageStore._(await LocalStore.baseDir(), owner, session);
+    store.assertActive();
+    return store;
+  }
+
+  void assertActive() {
+    if (AccountScope.currentAccountId != ownerId ||
+        AccountScope.sessionRevision.value != _session) {
+      throw StateError('The studio account changed. Reopen Collages.');
+    }
+  }
+
+  File get _file => File('${_root.path}/collages/library.json');
+
+  Future<List<SavedCollageVersion>> versions() async {
+    assertActive();
+    final value = await AtomicJsonStore.read(_file,
+        empty: {'ownerId': ownerId, 'versions': <dynamic>[]});
+    assertActive();
+    if (value is! Map ||
+        value['ownerId'] != ownerId ||
+        value['versions'] is! List) {
+      throw StateError(
+          'This collage library belongs to a different studio account.');
+    }
+    return (value['versions'] as List).map((entry) {
+      if (entry is! Map) {
+        throw const FormatException('Invalid saved collage version.');
+      }
+      return SavedCollageVersion.fromJson(entry);
+    }).toList();
+  }
+
+  Future<SavedCollageVersion> save(CollageTemplate template,
+      {String? templateId}) async {
+    assertActive();
+    final document = CollageTemplate.parse(template.toJson());
+    late SavedCollageVersion saved;
+    await AtomicJsonStore.update(_file,
+        empty: {'ownerId': ownerId, 'versions': <dynamic>[]}, change: (value) {
+      assertActive();
+      if (value is! Map ||
+          value['ownerId'] != ownerId ||
+          value['versions'] is! List) {
+        throw StateError('The private collage library could not be verified.');
+      }
+      final entries = (value['versions'] as List)
+          .map((entry) => SavedCollageVersion.fromJson(entry as Map))
+          .toList();
+      final id = templateId ?? const Uuid().v4();
+      if (templateId != null &&
+          !entries.any((entry) => entry.templateId == id)) {
+        throw StateError('Save an imported design as a new template.');
+      }
+      final revisions =
+          entries.where((entry) => entry.templateId == id).toList();
+      saved = SavedCollageVersion(
+          templateId: id,
+          versionId: const Uuid().v4(),
+          revision: revisions.fold(0,
+                  (max, entry) => entry.revision > max ? entry.revision : max) +
+              1,
+          savedAt: DateTime.now().toUtc(),
+          template: document);
+      return {
+        'ownerId': ownerId,
+        'versions': [
+          ...entries.map((entry) => entry.toJson()),
+          saved.toJson(),
+        ]
+      };
+    });
+    assertActive();
+    return saved;
+  }
+}
