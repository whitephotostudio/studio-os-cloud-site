+    AccountScope.sessionRevision.value++;
+    await tester.pump();
+    expect(find.byKey(const ValueKey('collage-commerce-price')), findsNothing);
+    expect(find.text('The studio account changed. Reopen Collages.'),
+        findsWidgets);
+    expect(tester.takeException(), isNull);
