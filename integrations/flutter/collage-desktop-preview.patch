+
+void main() {
+  test(
+      'mixed remote order preserves independent collage copies and ordinary print collapse',
+      () {
+    Map<String, dynamic> row(String id, {Object? snapshot}) => {
+          'id': id,
+          'product_name': '8x10',
+          'quantity': 1,
+          'sku': 'portrait.jpg',
+          'unit_price_cents': 2500,
+          'line_total_cents': 2500,
+          if (snapshot != null) 'collage_snapshot': snapshot,
+        };
+    final items = SupabaseSync.buildRemoteItemsForTest({
+      'package_name': 'Mixed package',
+      'order_items': [
+        row('copy-1', snapshot: {'version': 1, 'photo': 'media-1'}),
+        row('copy-2', snapshot: {'version': 1, 'photo': 'media-2'}),
+        row('print-1'),
+        row('print-2')
+      ]
+    });
+    expect(items, hasLength(3));
+    expect(items[0]['qty'], 1);
+    expect(items[1]['qty'], 1);
+    expect(items[0]['photoPath'], '');
+    expect(items[1]['photoPath'], '');
+    expect(items[0]['kind'], 'collage');
+    expect(items[1]['collageSnapshot'], {'version': 1, 'photo': 'media-2'});
+    expect(items[2]['qty'], 2);
+    expect(items[2]['lineTotalCents'], 5000);
+  });
+
+  test(
+      'collage snapshot survives typed reload/edit and cannot become a source-photo print',
+      () {
+    final item = OrderItem.fromJson({
+      'id': 'copy',
+      'sizeLabel': '8x10 collage.png',
+      'qty': 1,
+      'kind': 'collage',
+      'photoPath': '/private/original.jpg',
+      'unitPriceCents': 2500,
+      'lineTotalCents': 2500,
+      'collageSnapshot': {
+        'schemaVersion': 1,
+        'templateVersionId': 'immutable-version'
+      }
+    });
+    expect(item.isCollage, isTrue);
+    expect(item.isDigital, isFalse);
+    expect(item.isNonPrintCharge, isFalse);
+    expect(item.hasPhoto, isFalse);
+    for (final copy in [
+      OrderItem.fromJson(item.toJson()),
+      item.copyWith(qty: 2),
+      item.copyWith(photoPath: '/private/another.jpg'),
+      item.withProductionEdit('/private/edit.jpg')
+    ]) {
+      expect(copy.collageSnapshot, item.collageSnapshot);
+      expect(copy.hasPhoto, isFalse);
+    }
+    expect(item.effectiveLineCents, 2500);
+  });
+
+  test('existing ordinary prints remain assignable', () {
+    const item = OrderItem(
+        id: 'print',
+        sizeLabel: '8x10',
+        qty: 1,
+        photoPath: '/private/original.jpg',
+        unitPriceCents: 1000);
+    expect(item.hasPhoto, isTrue);
+    expect(item.isCollage, isFalse);
+    expect(OrderItem.fromJson(item.toJson()).hasPhoto, isTrue);
+  });
+
+  test('collage kind overrides names containing ordinary product categories',
+      () {
+    for (final name in [
+      'Graduation poster',
+      'School Memories frame',
+      'Canvas keepsake',
+      'Digital collage.png'
+    ]) {
+      final item = OrderItem(
+          id: name, sizeLabel: '$name • 8×10 collage', qty: 1, kind: 'collage');
+      expect(item.isSpecialty, false);
+      expect(item.isCanvas, false);
+      expect(item.isDigital, false);
+      expect(isNoritsuPrintItem(item), true);
