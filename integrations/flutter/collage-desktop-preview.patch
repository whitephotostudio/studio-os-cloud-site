+@visibleForTesting
+Future<Order> resolveOrderCollagePrintItems(
+    {required Order order, CollageProductionService? service}) async {
+  if (!order.items.any((item) => item.isCollage)) return order;
+  if (order.isClosed || order.isUnpaidCart) {
+    throw StateError('This collage order is closed or unpaid.');
+  }
+  final resolver = service ??
+      collageProductionServiceOverrideForTest ??
+      CollageProductionService(await CollageStore.open());
+  final cloudOrderId =
+      (await SupabaseSync.resolveCloudOrderIds([order.id])).single;
+  final items = <OrderItem>[];
+  for (final item in order.items) {
+    if (!item.isCollage) {
+      items.add(item);
+      continue;
+    }
+    final snapshot = item.collageSnapshot;
+    if (snapshot == null) {
+      throw StateError('The collage production recipe is missing.');
+    }
+    final receipt = await resolver.prepare(
+        cloudOrderId: cloudOrderId,
+        itemId: item.id,
+        snapshot: snapshot,
+        expectedQuantity: item.qty);
+    items.add(item.withCollageProduction(receipt));
+  }
+  return order.copyWith(items: items);
+}
