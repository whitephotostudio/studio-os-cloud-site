@@ -0,0 +1,378 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:image/image.dart' as img;
+import 'package:whitephoto_studio_app/screens/orders_screen.dart';
+import 'package:whitephoto_studio_app/services/bounded_http_request.dart';
+import 'package:whitephoto_studio_app/services/collage_production_service.dart';
+import 'package:whitephoto_studio_app/storage/account_scope.dart';
+import 'package:whitephoto_studio_app/storage/collage_store.dart';
+import 'package:whitephoto_studio_app/storage/local_store.dart';
+
+const orderId = '44444444-4444-4444-8444-444444444444';
+const itemId = '55555555-5555-4555-8555-555555555555';
+const secondItemId = '66666666-6666-4666-8666-666666666666';
+
+Map<String, dynamic> recipe(
+    {double bleed = 0, double cropX = .5, String name = 'Test print'}) {
+  final design = <String, dynamic>{
+    'version': 1,
+    'name': name,
+    'widthInches': 4,
+    'heightInches': 4,
+    'background': '#ffffff',
+    'ink': '#000000',
+    'overlay': null,
+    if (bleed != 0) 'bleedInches': bleed,
+    'slots': [
+      {'id': 'main', 'label': 'Main', 'x': 0, 'y': 0, 'width': 1, 'height': 1}
+    ],
+    'caption': {'x': .5, 'y': .82, 'size': .028},
+  };
+  return {
+    'version': 1,
+    'templateVersionId': '22222222-2222-4222-8222-222222222222',
+    'templateId': '33333333-3333-4333-8333-333333333333',
+    'photographerId': '11111111-1111-4111-8111-111111111111',
+    'versionNumber': 1,
+    'design': design,
+    'artworkKey': null,
+    'contentHash': collageCanonicalHash([design, null]),
+    'caption': {'studentName': '', 'schoolName': '', 'year': ''},
+    'placements': [
+      {
+        'slotId': 'main',
+        'mediaId': 'source',
+        'mediaKey': 'schools/original.jpg',
+        'zoom': 1.0,
+        'x': cropX,
+        'y': .5
+      }
+    ],
+  };
+}
+
+BoundedHttpResponse response(Map<String, dynamic> snapshot, Uint8List bytes,
+    {String id = itemId, Map<String, String> replace = const {}}) {
+  final design = snapshot['design'] as Map;
+  final bleed = (design['bleedInches'] as num?)?.toDouble() ?? 0;
+  return BoundedHttpResponse(200, bytes, headers: {
+    'x-collage-order-id': orderId,
+    'x-collage-item-id': id,
+    'x-collage-template-hash': snapshot['contentHash'] as String,
+    'x-collage-recipe-hash':
+        collageCanonicalHash(normalizeCollageOrderRecipe(snapshot)),
+    'x-collage-sha256': sha256.convert(bytes).toString(),
+    'x-collage-width': '${((4 + 2 * bleed) * 300).round()}',
+    'x-collage-height': '${((4 + 2 * bleed) * 300).round()}',
+    'x-collage-resolution-warnings': '0',
+    'x-collage-quantity': '1',
+    ...replace,
+  });
+}
+
+Uint8List png({int size = 1200}) {
+  final source = img.Image(width: size, height: size, numChannels: 3);
+  img.fill(source, color: img.ColorRgb8(255, 0, 0));
+  img.fillRect(source,
+      x1: 38,
+      y1: 38,
+      x2: size - 39,
+      y2: size - 39,
+      color: img.ColorRgb8(0, 255, 0));
+  return Uint8List.fromList(img.encodePng(source));
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory root;
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('collage-production-fixture-');
+    LocalStore.debugStorageRoot = root;
+    AccountScope.debugAccountId = 'fixture-owner';
+  });
+  tearDown(() async {
+    collageProductionServiceOverrideForTest = null;
+    LocalStore.debugStorageRoot = null;
+    AccountScope.debugAccountId = null;
+    await root.delete(recursive: true);
+  });
+
+  test(
+      'canonical Cloud golden design and recipe hashes agree across JSON number representations',
+      () {
+    final snapshot = recipe();
+    expect(snapshot['contentHash'],
+        '3415f5217e26c235a20598afcf8df9a5b58b3d2804d86ad35cd45ca0674c6c41');
+    expect(collageCanonicalHash(normalizeCollageOrderRecipe(snapshot)),
+        'a11590092089d8bd64c4d7b9955c7be490f51ef5b0e241f26dd37a0b8a0b49de');
+    final copied = jsonDecode(jsonEncode(snapshot)) as Map<String, dynamic>;
+    (copied['placements'] as List).first['x'] = .25;
+    expect(collageCanonicalHash(normalizeCollageOrderRecipe(copied)),
+        isNot(collageCanonicalHash(normalizeCollageOrderRecipe(snapshot))));
+  });
+
+  test('shared JavaScript trim preserves U+0085 in design and caption hashes',
+      () {
+    final snapshot = recipe(name: '\u0085Test print\u0085');
+    snapshot['caption'] = {
+      'studentName': '\u0085Student\u0085',
+      'schoolName': '\u0085School\u0085',
+      'year': '\u00852026\u0085'
+    };
+    final normalized = normalizeCollageOrderRecipe(snapshot);
+    expect(normalized['contentHash'],
+        '7a891530b891349b02b22a142e1448830b9fea247cd26f37b832a1cb6ded8558');
+    expect(collageCanonicalHash(normalized),
+        'ea21bde20d540f0a62de0ee1c79ab09e36c67304d89fbb8da088ef4951842feb');
+  });
+
+  test(
+      'immutable collage dimensions override display names with sizes or product keywords',
+      () {
+    for (final name in [
+      'Wallet memories',
+      '5x7 graduation',
+      'Backdrop poster',
+      '★ Canvas frame'
+    ]) {
+      final item = OrderItem(
+          id: itemId,
+          sizeLabel: '$name • 4×4 collage',
+          qty: 1,
+          kind: 'collage',
+          collageSnapshot: recipe(name: name));
+      expect(noritsuItemPrintSizeInches(item), (4.0, 4.0));
+      expect(isNoritsuPrintItem(item), true);
+      expect(item.isBackdropCharge, false);
+      expect(findOrderBackdropCharge([item]), isNull);
+      expect(
+          () => ensureNoritsuPrintItemSizesAvailable([item]), returnsNormally);
+    }
+    expect(
+        noritsuItemPrintSizeInches(
+            const OrderItem(id: 'wallet', sizeLabel: 'Wallet', qty: 1)),
+        (2.5, 3.5));
+  });
+
+  test(
+      'paid response is bound to recipe and cached with trim derivative and immutable source receipt',
+      () async {
+    final snapshot = recipe(bleed: .125);
+    final bytes = png(size: 1275);
+    final store = await CollageStore.open();
+    var downloads = 0;
+    final service =
+        CollageProductionService(store, download: (order, item) async {
+      downloads++;
+      expect(order, orderId);
+      expect(item, itemId);
+      return response(snapshot, bytes);
+    });
+    final receipt = await service.prepare(
+        cloudOrderId: orderId, itemId: itemId, snapshot: snapshot);
+    expect(receipt.width, 1200);
+    expect(receipt.height, 1200);
+    final output = img.decodePng(await File(receipt.printPath).readAsBytes())!;
+    expect([output.width, output.height], [1200, 1200]);
+    expect(output.getPixel(600, 600).g, 255);
+    expect(
+        sha256.convert(await File(receipt.sourcePath).readAsBytes()).toString(),
+        sha256.convert(bytes).toString());
+    expect(
+        await File('${File(receipt.printPath).parent.path}/receipt.json')
+            .exists(),
+        isTrue);
+    await receipt.verify(expectedItemId: itemId, snapshot: snapshot);
+    await service.prepare(
+        cloudOrderId: orderId, itemId: itemId, snapshot: snapshot);
+    expect(downloads, 2,
+        reason: 'a cache never grants continued payment authority');
+  });
+
+  test(
+      'wrong identity, recipe, pixels or source hash fails before any production-cache write',
+      () async {
+    final snapshot = recipe();
+    final bytes = png();
+    final store = await CollageStore.open();
+    for (final bad in [
+      {'x-collage-order-id': secondItemId},
+      {'x-collage-item-id': secondItemId},
+      {'x-collage-recipe-hash': '0' * 64},
+      {'x-collage-template-hash': '0' * 64},
+      {'x-collage-width': '1201'},
+      {'x-collage-sha256': '0' * 64},
+      {'x-collage-quantity': '2'},
+    ]) {
+      final service = CollageProductionService(store,
+          download: (_, __) async => response(snapshot, bytes, replace: bad));
+      await expectLater(
+          service.prepare(
+              cloudOrderId: orderId, itemId: itemId, snapshot: snapshot),
+          throwsStateError);
+    }
+    final wrongPixels = CollageProductionService(store,
+        download: (_, __) async => response(snapshot, png(size: 300)));
+    await expectLater(
+        wrongPixels.prepare(
+            cloudOrderId: orderId, itemId: itemId, snapshot: snapshot),
+        throwsStateError);
+    expect(await Directory('${root.path}/collages/production').exists(), false);
+  });
+
+  test('tampered artifact and account switch invalidate verified receipts',
+      () async {
+    final snapshot = recipe();
+    final bytes = png();
+    final store = await CollageStore.open();
+    final service = CollageProductionService(store,
+        download: (_, __) async => response(snapshot, bytes));
+    final receipt = await service.prepare(
+        cloudOrderId: orderId, itemId: itemId, snapshot: snapshot);
+    await File(receipt.printPath).writeAsString('tampered');
+    await expectLater(
+        receipt.verify(expectedItemId: itemId, snapshot: snapshot),
+        throwsStateError);
+    await expectLater(
+        service.prepare(
+            cloudOrderId: orderId, itemId: itemId, snapshot: snapshot),
+        throwsStateError);
+    AccountScope.debugAccountId = 'another-owner';
+    expect(receipt.matches(itemId, snapshot), false);
+    await expectLater(
+        service.prepare(
+            cloudOrderId: orderId, itemId: itemId, snapshot: snapshot),
+        throwsStateError);
+  });
+
+  test('owner change during server render makes no cache write', () async {
+    final snapshot = recipe();
+    final bytes = png();
+    final store = await CollageStore.open();
+    final service = CollageProductionService(store, download: (_, __) async {
+      AccountScope.debugAccountId = 'another-owner';
+      return response(snapshot, bytes);
+    });
+    await expectLater(
+        service.prepare(
+            cloudOrderId: orderId, itemId: itemId, snapshot: snapshot),
+        throwsStateError);
+    expect(await Directory('${root.path}/collages/production').exists(), false);
+  });
+
+  test(
+      'final Noritsu publication rolls back if a verified collage changes after encoding',
+      () async {
+    final snapshot = recipe();
+    final bytes = png();
+    final store = await CollageStore.open();
+    final service = CollageProductionService(store,
+        download: (_, __) async => response(snapshot, bytes));
+    final original = Order(
+        id: orderId,
+        studentId: 'student',
+        studentName: 'Fixture',
+        className: 'Class',
+        receivedAt: DateTime.utc(2026),
+        status: 'needs_attention',
+        items: [
+          OrderItem(
+              id: itemId,
+              sizeLabel: '4x4 collage',
+              qty: 1,
+              kind: 'collage',
+              photoPath: '',
+              collageSnapshot: snapshot)
+        ]);
+    final resolved =
+        await resolveOrderCollagePrintItems(order: original, service: service);
+    final destination = '${root.path}/staged-output/run';
+    await expectLater(
+        prepareNoritsuPrintBatch(
+            destinationPath: destination,
+            temporaryRoot: root,
+            prepare: (stage) async {
+              await File('$stage/collage-copy-1.jpg').writeAsBytes(
+                  await renderVerifiedCollagePrintJpeg(resolved.items.single));
+              await File(resolved.items.single.photoPath!)
+                  .writeAsString('changed after final encoding');
+              return 1;
+            },
+            beforePublish: () =>
+                ensureCollageProductionReceiptsCurrent([resolved])),
+        throwsStateError);
+    expect(await Directory(destination).exists(), false);
+    expect(original.items.single.photoPath, '');
+  });
+
+  test(
+      'mixed orders resolve each collage copy through paid preflight without persisting cache paths',
+      () async {
+    final snapshots = {
+      itemId: recipe(cropX: .25),
+      secondItemId: recipe(cropX: .75)
+    };
+    final bytes = png();
+    final store = await CollageStore.open();
+    final service = CollageProductionService(store,
+        download: (_, id) async => response(snapshots[id]!, bytes, id: id));
+    final original = Order(
+        id: orderId,
+        studentId: 'student',
+        studentName: 'Fixture',
+        className: 'Class',
+        receivedAt: DateTime.utc(2026),
+        status: 'needs_attention',
+        items: [
+          for (final id in snapshots.keys)
+            OrderItem(
+                id: id,
+                sizeLabel: '4x4 collage',
+                qty: 1,
+                kind: 'collage',
+                photoPath: '',
+                collageSnapshot: snapshots[id],
+                unitPriceCents: 2500,
+                lineTotalCents: 2500),
+          const OrderItem(
+              id: 'ordinary',
+              sizeLabel: '5x7',
+              qty: 1,
+              photoPath: '/fixture/original.jpg')
+        ]);
+    expect(isNewNoritsuPrintOrder(original), true);
+    expect(original.items.first.hasPhoto, false);
+    expect(original.items.first.hasCompleteCollageSelection, true);
+    expect(original.allPhotosAssigned, true,
+        reason: 'parent selections are complete before native rendering');
+    final resolved =
+        await resolveOrderCollagePrintItems(order: original, service: service);
+    expect(
+        resolved.items.take(2).every((item) => item.hasPhoto && item.isCollage),
+        true);
+    expect(resolved.items[0].photoPath, isNot(resolved.items[1].photoPath));
+    expect(resolved.items.last.photoPath, '/fixture/original.jpg');
+    expect(resolved.toJson(), original.toJson(),
+        reason: 'cache artifacts and receipts remain runtime-only');
+    expect(Order.fromJson(resolved.toJson()).items.first.hasPhoto, false);
+    ensureNoritsuPrintItemSizesAvailable(resolved.items);
+    await ensureCollageProductionReceiptsCurrent([resolved]);
+    final jpeg = await renderVerifiedCollagePrintJpeg(resolved.items.first);
+    final printed = img.decodeJpg(jpeg)!;
+    expect([printed.width, printed.height], [1200, 1200]);
+    expect(printed.getPixel(600, 600).g, greaterThan(250));
+    expect(printed.getPixel(3, 3).r, greaterThan(250),
+        reason: 'whole finished artwork remains uncropped');
+    expect([jpeg[13], jpeg[14] * 256 + jpeg[15], jpeg[16] * 256 + jpeg[17]],
+        [1, 300, 300]);
+    expect(resolved.items.first.copyWith(qty: 2).hasPhoto, false);
+    await File(resolved.items.first.photoPath!)
+        .writeAsString('changed after preparation');
+    await expectLater(
+        ensureCollageProductionReceiptsCurrent([resolved]), throwsStateError);
+  });
+}
diff --git a/test/collage_renderer_test.dart b/test/collage_renderer_test.dart
new file mode 100644
index 0000000..e9562f2
--- /dev/null
+++ b/test/collage_renderer_test.dart
@@ -0,0 +1,103 @@
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:image/image.dart' as img;
+import 'package:whitephoto_studio_app/models/collage_template.dart';
+import 'package:whitephoto_studio_app/services/collage_renderer.dart';
+
+void main() {
+  testWidgets('EXIF portrait orientation is normalized before crop calculation',
+      (tester) async {
+    await tester.runAsync(() async {
+      final source = img.Image(width: 60, height: 30);
+      img.fill(source, color: img.ColorRgb8(255, 0, 0));
+      source.exif.imageIfd.orientation = 6;
+      final decoded =
+          await decodeCollageImage(Uint8List.fromList(img.encodeJpg(source)));
+      expect([decoded.width, decoded.height], [30, 60]);
+      decoded.dispose();
+    });
+  });
+
+  testWidgets(
+      'preview and 300ppi output share independent crops, layering, bleed and borders',
+      (tester) async {
+    await tester.runAsync(() async {
+      final source = img.Image(width: 120, height: 40);
+      img.fill(source, color: img.ColorRgb8(255, 0, 0));
+      img.fillRect(source,
+          x1: 60, y1: 0, x2: 119, y2: 39, color: img.ColorRgb8(0, 0, 255));
+      final image =
+          await decodeCollageImage(Uint8List.fromList(img.encodePng(source)));
+      final artwork = img.Image(width: 100, height: 100, numChannels: 4);
+      img.fill(artwork, color: img.ColorRgba8(0, 0, 0, 0));
+      img.fillRect(artwork,
+          x1: 5, y1: 5, x2: 20, y2: 20, color: img.ColorRgba8(0, 255, 0, 255));
+      final template = CollageTemplate.parse({
+        'version': 1,
+        'name': 'Renderer fixture',
+        'widthInches': 4,
+        'heightInches': 4,
+        'background': '#ffdd00',
+        'ink': '#000000',
+        'bleedInches': .125,
+        'overlay':
+            'data:image/png;base64,${base64Encode(img.encodePng(artwork))}',
+        'slots': [
+          {
+            'id': 'left',
+            'label': 'Left',
+            'x': .1,
+            'y': .1,
+            'width': .35,
+            'height': .6,
+            'border': {'color': '#ffffff', 'widthInches': .05}
+          },
+          {
+            'id': 'right',
+            'label': 'Right',
+            'x': .55,
+            'y': .1,
+            'width': .35,
+            'height': .6
+          },
+        ],
+        'caption': {'x': .5, 'y': .8, 'size': .02},
+      });
+      final overlay = await loadCollageOverlay(template);
+      final placements = {
+        'left': CollagePlacement(image, 'same-original.png', x: 0),
+        'right': CollagePlacement(image, 'same-original.png', x: 1),
+      };
+      for (final size in <int?>[510, null]) {
+        final output = img.decodePng(await renderCollagePng(
+            template, placements, [],
+            overlay: overlay, previewWidth: size))!;
+        expect(output.width, size ?? 1275);
+        expect(output.height, size ?? 1275);
+        List<int> at(double x, double y) {
+          final scale = output.width / 4.25;
+          final pixel = output.getPixel(((.125 + x * 4) * scale).floor(),
+              ((.125 + y * 4) * scale).floor());
+          return [pixel.r.toInt(), pixel.g.toInt(), pixel.b.toInt()];
+        }
+
+        expect(at(.12, .12), [0, 255, 0],
+            reason: 'artwork layers above photos');
+        expect(at(.25, .4), [255, 0, 0], reason: 'first copy uses left crop');
+        expect(at(.65, .4), [0, 0, 255],
+            reason: 'same photo can use independent right crop');
+        expect(at(.102, .4), [255, 255, 255],
+            reason: 'physical border width stays inside opening');
+        final bleed = output.getPixel(0, 0);
+        expect(
+            [bleed.r.toInt(), bleed.g.toInt(), bleed.b.toInt()], [255, 221, 0]);
+      }
+      image.dispose();
+      overlay?.dispose();
+      await expectLater(renderCollagePng(template, {}, [], previewWidth: 300),
+          throwsStateError);
+    });
+  });
+}
diff --git a/test/collage_store_test.dart b/test/collage_store_test.dart
new file mode 100644
index 0000000..d834ed5
--- /dev/null
+++ b/test/collage_store_test.dart
@@ -0,0 +1,77 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:whitephoto_studio_app/models/collage_template.dart';
+import 'package:whitephoto_studio_app/storage/account_scope.dart';
+import 'package:whitephoto_studio_app/storage/collage_store.dart';
+import 'package:whitephoto_studio_app/storage/local_store.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory root;
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('collage-library-');
+    LocalStore.debugStorageRoot = root;
+    AccountScope.debugAccountId = 'collage-owner';
+  });
+  tearDown(() async {
+    LocalStore.debugStorageRoot = null;
+    AccountScope.debugAccountId = null;
+    await root.delete(recursive: true);
+  });
+
+  test('versions are immutable and reopened design has no test-photo state',
+      () async {
+    final store = await CollageStore.open();
+    final first = await store.save(CollageTemplate.preset());
+    final second = await store.save(
+        first.template.changed({'name': 'Edited design'}),
+        templateId: first.templateId);
+    expect(second.templateId, first.templateId);
+    expect(second.versionId, isNot(first.versionId));
+    expect(second.revision, 2);
+    final reopened = await (await CollageStore.open()).versions();
+    expect(reopened.first.template.name, 'Three favourite moments');
+    expect(reopened.last.template.name, 'Edited design');
+    expect(await File('${root.path}/collages/library.json').readAsString(),
+        isNot(contains('photoPath')));
+  });
+
+  test('simultaneous saves allocate unique revisions atomically', () async {
+    final store = await CollageStore.open();
+    final first = await store.save(CollageTemplate.preset());
+    final saves = await Future.wait(List.generate(
+        3,
+        (i) => store.save(first.template.changed({'name': 'Edit $i'}),
+            templateId: first.templateId)));
+    expect(saves.map((entry) => entry.revision).toSet(), {2, 3, 4});
+    expect(await store.versions(), hasLength(4));
+  });
+
+  test('owner change and same-owner session replacement stop pending views',
+      () async {
+    final store = await CollageStore.open();
+    await store.save(CollageTemplate.preset());
+    AccountScope.debugAccountId = 'another-owner';
+    await expectLater(store.versions(), throwsStateError);
+    await expectLater(store.save(CollageTemplate.preset()), throwsStateError);
+    await expectLater((await CollageStore.open()).versions(), throwsStateError);
+    AccountScope.debugAccountId = 'collage-owner';
+    AccountScope.sessionRevision.value++;
+    await expectLater(store.save(CollageTemplate.preset()), throwsStateError);
+    expect(await (await CollageStore.open()).versions(), hasLength(1));
+  });
+
+  test(
+      'unknown template id cannot overwrite another record and corruption is detected',
+      () async {
+    final store = await CollageStore.open();
+    final first = await store.save(CollageTemplate.preset());
+    await expectLater(
+        store.save(first.template, templateId: 'unknown'), throwsStateError);
+    final file = File('${root.path}/collages/library.json');
+    await file.writeAsString((await file.readAsString())
+        .replaceAll('Three favourite moments', 'Changed without save'));
+    await expectLater(store.versions(), throwsFormatException);
+  });
+}
diff --git a/test/collage_template_test.dart b/test/collage_template_test.dart
