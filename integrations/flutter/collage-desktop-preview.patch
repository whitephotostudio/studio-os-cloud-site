+    expect(item.hasPhoto, isFalse);
+    for (final copy in [
+      OrderItem.fromJson(item.toJson()),
+      item.copyWith(qty: 2),
+      item.copyWith(photoPath: '/private/another.jpg'),
+      item.withProductionEdit('/private/edit.jpg')
+    ]) {
+      expect(copy.collageSnapshot, item.collageSnapshot);
+      expect(copy.hasPhoto, isFalse);
+    }
+    expect(item.effectiveLineCents, 2500);
+  });
+
+  test('existing ordinary prints remain assignable', () {
+    const item = OrderItem(
+        id: 'print',
+        sizeLabel: '8x10',
+        qty: 1,
+        photoPath: '/private/original.jpg',
+        unitPriceCents: 1000);
+    expect(item.hasPhoto, isTrue);
+    expect(item.isCollage, isFalse);
+    expect(OrderItem.fromJson(item.toJson()).hasPhoto, isTrue);
+  });
+
+  test('collage kind overrides names containing ordinary product categories',
+      () {
+    for (final name in [
+      'Graduation poster',
+      'School Memories frame',
+      'Canvas keepsake',
+      'Digital collage.png'
+    ]) {
+      final item = OrderItem(
+          id: name, sizeLabel: '$name • 8×10 collage', qty: 1, kind: 'collage');
+      expect(item.isSpecialty, false);
+      expect(item.isCanvas, false);
+      expect(item.isDigital, false);
+      expect(isNoritsuPrintItem(item), true);
+    }
+  });
+}
