+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:whitephoto_studio_app/models/collage_template.dart';
+import 'package:whitephoto_studio_app/services/bounded_http_request.dart';
+import 'package:whitephoto_studio_app/services/collage_cloud_service.dart';
+import 'package:whitephoto_studio_app/storage/account_scope.dart';
+import 'package:whitephoto_studio_app/storage/collage_store.dart';
+import 'package:whitephoto_studio_app/storage/local_store.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory root;
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('collage-cloud-fixture-');
+    LocalStore.debugStorageRoot = root;
+    AccountScope.debugAccountId = 'fixture-owner';
+  });
+  tearDown(() async {
+    LocalStore.debugStorageRoot = null;
+    AccountScope.debugAccountId = null;
+    await root.delete(recursive: true);
+  });
+  const id = '00000000-0000-4000-8000-000000000001';
+  Map<String, dynamic> version() => {
+        'id': id,
+        'templateId': id,
+        'versionNumber': 1,
+        'design': CollageTemplate.preset().toJson(),
+        'published': false
+      };
+
+  test(
+      'explicit native Cloud draft save is authenticated, versioned and unpublished',
+      () async {
+    final store = await CollageStore.open();
+    final service = CollageCloudService(store,
+        token: () => 'fixture-token',
+        request: (
+            {required method,
+            required uri,
+            required timeout,
+            headers = const {},
+            body = const [],
+            maxResponseBytes = 0}) async {
+          expect(method, 'POST');
+          expect(uri.host, 'www.studiooscloud.com');
+          expect(uri.path, '/api/dashboard/collages');
+          expect(headers['Authorization'], 'Bearer fixture-token');
+          final payload = jsonDecode(utf8.decode(body));
+          expect(payload['publish'], false);
+          expect(payload['templateId'], id);
+          expect(payload['design'], CollageTemplate.preset().toJson());
+          return BoundedHttpResponse(
+              201,
+              Uint8List.fromList(
+                  utf8.encode(jsonEncode({'version': version()}))));
+        });
+    final saved =
+        await service.saveDraft(CollageTemplate.preset(), templateId: id);
+    expect(saved.id, id);
+    expect(saved.published, false);
+  });
+
+  test('list/load reject changed accounts and malformed production output',
+      () async {
+    final store = await CollageStore.open();
+    var requests = 0;
+    final service = CollageCloudService(store,
+        token: () => 'fixture-token',
+        request: (
+            {required method,
+            required uri,
+            required timeout,
+            headers = const {},
+            body = const [],
+            maxResponseBytes = 0}) async {
+          requests++;
+          if (uri.path.endsWith('production')) {
+            return BoundedHttpResponse(200, Uint8List.fromList([1, 2, 3]));
+          }
+          return BoundedHttpResponse(
+              200,
+              Uint8List.fromList(utf8.encode(jsonEncode(uri.path.endsWith(id)
+                  ? {'version': version()}
+                  : {
+                      'versions': [version()]
+                    }))));
+        });
+    expect(await service.list(), hasLength(1));
+    expect((await service.load(id)).id, id);
+    await expectLater(service.downloadProduction(id, id), throwsStateError);
+    await expectLater(service.load('../outside'), throwsFormatException);
+    AccountScope.debugAccountId = 'other-owner';
+    await expectLater(service.list(), throwsStateError);
+    expect(requests, 3);
+  });
+}
