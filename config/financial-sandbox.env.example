# PLACEHOLDERS ONLY. Copy to an ignored .env.financial-sandbox.local file.
# Never copy .env.local: it contains production credentials.
# This verifier is run explicitly, outside the production prebuild chain.
STUDIO_FINANCIAL_SANDBOX_VERIFY=0
VERCEL_ENV=preview
VERCEL_GIT_COMMIT_REF=codex/credit-system-audit-20260929
STUDIO_SANDBOX_EXPECTED_PROJECT_REF=REPLACE_WITH_SEPARATE_20_CHAR_PROJECT_REF
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_SEPARATE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SANDBOX_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SANDBOX_SERVICE_KEY
STUDIO_SANDBOX_EXPECTED_APP_ORIGIN=https://REPLACE_WITH_SEPARATE_SANDBOX.vercel.app

# Private server-only keys from one Stripe sandbox/test environment.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_SANDBOX_SECRET
STRIPE_BILLING_CURRENCY=cad
STUDIO_SANDBOX_EXPECTED_STRIPE_ACCOUNT_ID=acct_REPLACE_WITH_SANDBOX_ACCOUNT
STUDIO_SANDBOX_PLATFORM_WEBHOOK_ID=we_REPLACE_WITH_TEST_PLATFORM_ENDPOINT
STUDIO_SANDBOX_CONNECT_WEBHOOK_ID=we_REPLACE_WITH_TEST_CONNECT_ENDPOINT
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_REPLACE_WITH_TEST_PLATFORM_SECRET
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_WITH_TEST_CONNECT_SECRET
# Keep unset: STRIPE_WEBHOOK_SECRET (the legacy catch-all signing secret).
# Optional, comma separated, at most ten IDs from actual sandbox events:
STUDIO_SANDBOX_EVENT_IDS=

# No production verification/configuration or paid-provider/storage diagnostic.
STUDIO_PAYMENT_RELEASE_VERIFY=0
STUDIO_CREDIT_WEBHOOK_CONFIGURE=0
STUDIO_PHOTOROOM_PREVIEW_VERIFY=0
STUDIO_PHOTOROOM_SAMPLE_VERIFY=0
STUDIO_R2_STAGING_PREVIEW_VERIFY=0
# Keep checkout paused until isolation, schema, auth and webhooks are confirmed.
STUDIO_CREDIT_MAINTENANCE=1

# Add a sandbox-only CRON_SECRET before exercising retry/expiry routes.
# Do not reuse customer-media R2 or outbound email credentials. A generated
# image provider/staging smoke is a separate opt-in from financial verification.
